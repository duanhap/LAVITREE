# ========================================================
# LAVITREE ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Mật khẩu Supabase Database
# Chỉ cần điền mật khẩu bạn đã đặt lúc tạo project Supabase vào đây:
DB_PASSWORD=YOUR_PASSWORD_HERE

# 2. Chuỗi kết nối đầy đủ tới Supabase (Tùy chọn nếu muốn ghi đè):
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.mhipxrhamwtxntgdwwoe;Password=YOUR_PASSWORD_HERE;SSL Mode=Require;Trust Server Certificate=true;

# 3. Microservice Endpoints
AI_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:8001

# 4. AI Vision Service Configuration
# Ngưỡng Energy Score phát hiện Out-of-Distribution (OOD) theo Liu et al. (NeurIPS 2020)
# Mẫu có S_energy < OOD_ENERGY_THRESHOLD sẽ bị gắn cờ is_ood = true.
# Để trống nếu muốn tắt bộ lọc Energy (mặc định is_ood = false khi dev):
OOD_ENERGY_THRESHOLD=

# 5. Core API Admin Security (Header X-Admin-Key, tối thiểu 32 ký tự ngẫu nhiên)
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_KEY_AT_LEAST_32_CHARS
RATE_LIMIT_PER_MINUTE=60

# 6. MinIO Object Storage (Không dùng mật khẩu mặc định lộ trong commit cũ)
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YOUR_NEW_SECURE_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=lavitree-diagnoses


