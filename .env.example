# ========================================================
# LAVITREE ROOT ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# 1. CƠ SỞ DỮ LIỆU (DATABASE CONFIGURATION)
# Mật khẩu kết nối CSDL Supabase Cloud hoặc Local PostgreSQL Docker
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
POSTGRES_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD_HERE

# Chuỗi kết nối Entity Framework Core tới Supabase PostgreSQL:
# (Nếu dùng local PostgreSQL docker, để trống hoặc comment lại để dùng DefaultConnection)
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.mhipxrhamwtxntgdwwoe;Password=YOUR_DATABASE_PASSWORD_HERE;SSL Mode=Require;Trust Server Certificate=true;

# 2. ĐỊA CHỈ MICROSERVICES (ENDPOINTS)
AI_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:8001
CORE_API_URL=http://localhost:5000

# 3. CẤU HÌNH AI VISION SERVICE (RESNET-18 + GRAD-CAM + OOD FILTER)
# Ngưỡng Energy Score phát hiện Out-of-Distribution (OOD) theo Liu et al. (NeurIPS 2020)
# Mẫu có S_energy < OOD_ENERGY_THRESHOLD sẽ bị gắn cờ is_ood = true.
# Giá trị thực nghiệm Sprint 1: -2.5 (lá thật: -0.55, tay người/ngoại lai: -4.40).
OOD_ENERGY_THRESHOLD=-2.5
# Cho phép giả lập phản hồi OOD (chỉ bật khi dev/testing, mặc định false ở production):
ALLOW_MOCK_OOD=false

# 4. BẢO MẬT CORE API & TẦN SUẤT TRUY CẬP (SECURITY & RATE LIMITING)
# Khóa bảo vệ các API quản trị tri thức (Header X-Admin-Key, tối thiểu 32 ký tự ngẫu nhiên)
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_KEY_AT_LEAST_32_CHARS
# Giới hạn số lượt chẩn đoán (request/phút/IP) để chống DDoS & spam tính toán:
RATE_LIMIT_PER_MINUTE=60
# Danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Khóa bí mật ký phát JSON Web Token (JWT) cho tính năng Đăng nhập / Phân quyền:
JWT_SECRET=YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS

# 5. LƯU TRỮ ĐỐI TƯỢNG MINIO (OBJECT STORAGE)
# MinIO S3 API Endpoint nội bộ và URL công khai (Public URL trỏ qua cổng Nginx 3000 để xem ảnh ngoại mạng)
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:3000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YOUR_SECURE_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=lavitree-diagnoses

# 6. TÍCH HỢP AI TÁC TỬ & DỊCH VỤ NGOÀI (SPRINT 2: AGRI-AGENT & WEATHER)
# Khóa API Google Gemini (Gemini 2.0 / 2.5 Flash) cho Agent ReAct Loop:
GEMINI_API_KEY=
# Khóa API OpenWeatherMap cho công cụ dự báo rủi ro mưa rửa trôi thuốc BVTV:
OPENWEATHER_API_KEY=
