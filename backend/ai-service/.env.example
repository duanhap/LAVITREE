# ========================================================
# LAVITREE AI VISION SERVICE CONFIGURATION
# ========================================================

# Cổng và host chạy dịch vụ
HOST=127.0.0.1
PORT=8000

# Ngưỡng Energy Score phát hiện Out-of-Distribution (OOD) theo Liu et al. (NeurIPS 2020)
# Mẫu có S_energy < OOD_ENERGY_THRESHOLD sẽ bị gắn cờ is_ood = true.
# Nếu để trống: Hệ thống sẽ tắt kiểm tra Energy-based OOD (is_ood = false) và ghi log cảnh báo.
# Giá trị thực nghiệm Sprint 1: -2.5 (ảnh lá thật ~ -0.55, ảnh vật thể lạ/tay người ~ -4.40).
OOD_ENERGY_THRESHOLD=-2.5

# Cho phép mock OOD trong môi trường test (mặc định False ở production)
ALLOW_MOCK_OOD=false
